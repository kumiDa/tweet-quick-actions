{
  "manifest_version": 3,
  "name": "Tweet Quick Actions",
  "version": "1.1",
  "description": "One-click buttons on every tweet for Not interested, Request Community Note, Report, and Copy link.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tweet-quick-actions@kumida.github.io",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "clipboardWrite"
  ]
}
